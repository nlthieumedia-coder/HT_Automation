{
  "id": "com.hieuyt.htbinbuilder",
  "name": "HT_BinBuilder",
  "shortname": "HTBinBuilder",
  "version": "1.4.0",
  "main": "index.html",
  "manifestVersion": 6,
  "host": {
    "app": "premierepro",
    "minVersion": "26.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "htBinBuilderPanel",
      "label": { "default": "HT_BinBuilder" },
      "minimumSize": { "width": 340, "height": 540 },
      "maximumSize": { "width": 500, "height": 900 },
      "preferredDockedSize": { "width": 360, "height": 650 },
      "preferredFloatingSize": { "width": 420, "height": 720 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel-dark.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/panel-light.svg", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/logo_icon.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
