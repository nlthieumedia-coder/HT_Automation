{
  "name": "ht-downloader",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Windows desktop media scanner and downloader",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "prepare:binaries": "node scripts/prepare-binaries.mjs",
    "start": "npm run build && node scripts/start-electron.mjs",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.2.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.htdownloader.app",
    "productName": "HT Downloader",
    "asar": true,
    "files": ["dist/**/*", "package.json"],
    "extraResources": [{ "from": "resources/binaries", "to": "binaries", "filter": ["**/*"] }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
