{
  "manifestVersion": 5,
  "id": "com.antigravity.assetfinder",
  "name": "Asset Finder",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "assetFinderPanel",
      "label": {
        "default": "Asset Finder"
      },
      "minimumSize": {
        "width": 250,
        "height": 350
      },
      "preferredSize": {
        "width": 320,
        "height": 600
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}
