{
  "id": "com.hieuyt.htfinder",
  "name": "HT_Finder",
  "shortname": "HTFinder",
  "version": "2.0.3",
  "main": "index.html",
  "manifestVersion": 6,
  "host": { "app": "premierepro", "minVersion": "26.2.0" },
  "entrypoints": [{
    "type": "panel",
    "id": "htFinderPanel",
    "label": { "default": "HT_Finder" },
    "minimumSize": { "width": 300, "height": 420 },
    "maximumSize": { "width": 900, "height": 1200 },
    "preferredDockedSize": { "width": 380, "height": 680 },
    "preferredFloatingSize": { "width": 420, "height": 720 },
    "icons": [
      { "width": 23, "height": 23, "path": "icons/panel-dark.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
      { "width": 23, "height": 23, "path": "icons/panel-light.svg", "scale": [1, 2], "theme": ["lightest", "light"] }
    ]
  }],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/logo_icon.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": "all" }
  }
}
